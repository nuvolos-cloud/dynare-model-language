eter_uncertainty|no_error_bands|error_band_percentiles|shock_draws|shocks_per_parameter|thinning_factor|free_parameters|median|regime|regimes|data_obs_nbr|filtered_probabilities|real_time_smoothed|proposal_type|proposal_lower_bound|proposal_upper_bound|proposal_draws|use_mean_center|adaptive_mh_draws|coefficients_prior_hyperparameters|convergence_starting_value|convergence_ending_value|convergence_increment_value|max_iterations_starting_value|max_iterations_increment_value|max_block_iterations|max_repeated_optimization_runs|maxit|simul_maxit|likelihood_maxit|smoother_maxit|simul_periods|likelihood_periods|smoother_periods|simul_curb_retrench|likelihood_curb_retrench|smoother_curb_retrench|simul_check_ahead_periods|simul_max_check_ahead_periods|simul_reset_check_ahead_periods|likelihood_check_ahead_periods|likelihood_max_check_ahead_periods|smoother_check_ahead_periods|smoother_max_check_ahead_periods|simul_debug|smoother_debug|simul_periodic_solution|likelihood_periodic_solution|smoother_periodic_solution|likelihood_inversion_filter|likelihood_piecewise_kalman_filter|likelihood_max_kalman_iterations|smoother_inversion_filter|smoother_piecewise_kalman_filter|filter_use_relaxation|function_convergence_criterion|parameter_convergence_criterion|number_of_large_perturbations|number_of_small_perturbations|number_of_posterior_draws_after_perturbation|max_number_of_stages|random_function_convergence_criterion|random_parameter_convergence_criterion|tolf|tolx|opt_algo|add_flags|substitute_flags|add_libs|substitute_libs|compiler|instruments|hessian|prior_variance|identity_matrix|mcmc_jumping_covariance|bvar_prior_tau|bvar_prior_decay|bvar_prior_lambda|bvar_prior_mu|bvar_prior_omega|bvar_prior_flat|bvar_prior_train|bvar_replic|homotopy_mode|homotopy_steps|homotopy_force_continue|homotopy_max_completion_share|homotopy_min_step_size|homotopy_initial_step_size|homotopy_step_size_increase_success_count|homotopy_linearization_fallback|homotopy_marginal_linearization_fallback|homotopy_exclude_varexo|nocheck|controlled_varexo|parameter_set|init_state|fast_realtime|save_realtime|detail_plot|flip|interactive|screen_shocks|steadystate|type|qoq|yoy|aoa|unconditional|conditional|fig_name|write_xls|realtime|vintage|prior_mode|prior_mean|posterior_mode|posterior_mean|posterior_median|mle_mode|k_order_solver|filter_covariance|updated_covariance|filter_decomposition|smoothed_state_uncertainty|smoother_redux|selected_variables_only|pruning|save_draws|deflator|log_deflator|epilogue|growth_factor|log_growth_factor|growth|cova_compute|discretionary_tol|analytic_derivation|analytic_derivation_mode|solver_periods|endogenous_prior|consider_all_endogenous|consider_all_endogenous_and_auxiliary|consider_only_observed|infile|invars|period|outfile|outvars|huge_number|dr_display_tol|posterior_sampling_method|posterior_sampler_options|lmmcp|additional_optimizer_steps|bartlett_kernel_lag|analytical_girf|irf_in_percent|emas_girf|emas_drop|emas_tolf|emas_max_iter|variable|no_identification_strength|no_identification_reducedform|no_identification_moments|no_identification_minimal|no_identification_spectrum|normalize_jacobians|grid_nbr|tol_rank|tol_deriv|tol_sv|checks_via_subsets|max_dim_subsets_groups|max_nrows|with_epilogue|non_zero|preconditioner|first_iter_lu|block_diagonal_lu|incomplete_lu|iter_tol|iter_maxit|gmres_restart|block_diagonal_lu_maxlu|block_diagonal_lu_nperiods|block_diagonal_lu_nlu|block_diagonal_lu_relu|check_jacobian_singularity|values|scales|cutoff|static_mfs|heterogeneity|dsge_prior_weight|surprise|relative_to_initval|restriction|component|target|auxname|auxname_target_nonstationary|weights|exogenize|endogenize|solve_algo|dr_algo|simul_algo|stack_solve_algo|robust_lin_solve|allow_nonfinite_values|drop|lyapunov|lyapunov_complex_threshold|lyapunov_fixed_point_tol|lyapunov_doubling_tol|dr_cycle_reduction_tol|dr_cycle_reduction_maxiter|dr_logarithmic_reduction_tol|dr_logarithmic_reduction_maxiter|replic|ar|nofunctions|irf_shocks|hp_filter|one_sided_hp_filter|bandpass_filter|hp_ngrid|simul_seed|simul_replic|mh_recover|block_static|block_dynamic|incidence|upper_cholesky|lower_cholesky|use_dll|block|bytecode|all_values_required|no_static|differentiate_forward_vars|parallel_local_files|linear|var_expectation|pac_expectation|pac_target_nonstationary|sum|discount|function|sampling_draws)(?!\\w)"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.language.boolean.dynare",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.dynare",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dynare",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.dynare",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dynare",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.dynare",
                    "match": "\\b\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.date.dynare",
                    "match": "-?\\d+(?:[ya]|m(?:[1-9]|1[0-2])|q[1-4]|[sh][12])"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.dynare",
                    "match": "(\\+|\\-|\\*|/|==|!=|<=|>=|<|>|\\^|=)"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.function.dynare",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()",
                    "captures": {
                        "0": {
                            "name": "entity.name.function.dynare"
                        }
                    }
                },
                {
                    "name": "variable.other.dynare",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.dynare",
                    "match": "[,;]"
                },
                {
                    "name": "punctuation.parenthesis.dynare",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                }
            ]
        }
    }
}